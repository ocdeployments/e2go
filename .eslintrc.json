{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": [
    "local-rules"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "local-rules/require-supabase-error-check": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/middleware.ts",
        "src/app/api/**/*.ts",
        "src/app/api/**/*.tsx",
        "src/lib/**/*.ts",
        "src/lib/**/*.tsx"
      ],
      "rules": {
        "local-rules/require-supabase-error-check": "error"
      }
    },
    {

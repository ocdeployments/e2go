# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_HST_NUMBER=

# Stripe Price IDs (server-side)
# Create these products in the Stripe dashboard, then paste the price IDs here.
STRIPE_PRICE_COMPLETE=               # $1,495 — Complete package (solo / default)
STRIPE_PRICE_COMPLETE_PARTNERSHIP=   # $TBD   — Complete package (partnership) — price not yet decided
STRIPE_PRICE_INTERVIEW_PREP=         # $347   — Interview Prep add-on
STRIPE_PRICE_FDD_INTELLIGENCE=       # $575   — FDD Intelligence standalone
STRIPE_PRICE_FDD_INTELLIGENCE_LOYALTY= # $375 — FDD Intelligence loyalty (Complete owners only)
STRIPE_PRICE_SIMULATOR_3PACK=        # $49    — 3 extra simulator sessions
STRIPE_PRICE_RENEWAL=                # $99    — Application renewal

# Public Stripe Price IDs (used in client-side pricing page fallback)
NEXT_PUBLIC_STRIPE_PRICE_COMPLETE=   # Same as STRIPE_PRICE_COMPLETE

# Site
NEXT_PUBLIC_SITE_URL=

# Rate Limiting (Session 11: Ask E2go FAQ)
UPSTASH_REDIS_REST_URL=    # Optional — rate limiting disabled if missing (fail-open)
UPSTASH_REDIS_REST_TOKEN=  # Optional — rate limiting disabled if missing (fail-open)

{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/rebuild-profiles",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/health-watchdog",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/generation-resume",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/quiz-nurture",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/payment-reconciliation",
      "schedule": "0 5 * * *"
    }
  ]
}
